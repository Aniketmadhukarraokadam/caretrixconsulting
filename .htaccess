# =============================================
# Caretrix Consulting — Production .htaccess
# Apache Configuration for Shared Hosting
# =============================================

# ---- GZIP Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# ---- Browser Caching (Leverage Cache-Control) ----
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML - short cache (content changes)
  ExpiresByType text/html                       "access plus 1 hour"

  # CSS & JS
  ExpiresByType text/css                        "access plus 1 year"
  ExpiresByType application/javascript          "access plus 1 year"
  ExpiresByType text/javascript                 "access plus 1 year"

  # Images
  ExpiresByType image/png                       "access plus 1 year"
  ExpiresByType image/jpg                       "access plus 1 year"
  ExpiresByType image/jpeg                      "access plus 1 year"
  ExpiresByType image/gif                       "access plus 1 year"
  ExpiresByType image/webp                      "access plus 1 year"
  ExpiresByType image/svg+xml                   "access plus 1 year"
  ExpiresByType image/x-icon                    "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2                      "access plus 1 year"
  ExpiresByType font/woff                       "access plus 1 year"
  ExpiresByType application/font-woff           "access plus 1 year"
  ExpiresByType application/font-woff2          "access plus 1 year"

  # XML / Sitemap
  ExpiresByType application/xml                 "access plus 1 day"
  ExpiresByType text/xml                        "access plus 1 day"
</IfModule>

# ---- Cache-Control Headers ----
<IfModule mod_headers.c>
  # Long-lived static assets (versioned by filename ideally)
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|woff|woff2|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages — revalidate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---- Custom Error Pages ----
ErrorDocument 404 /index.html
ErrorDocument 500 /index.html

# ---- Directory Listing Security ----
Options -Indexes

# ---- Default Document ----
DirectoryIndex index.html

# ---- URL Clean-up: Remove trailing slashes & .html extension ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Redirect www to non-www (or vice versa — edit to match your setup)
  # RewriteCond %{HTTP_HOST} ^www\.caretrixconsulting\.com [NC]
  # RewriteRule ^(.*)$ https://caretrixconsulting.com/$1 [R=301,L]

  # Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Remove index.html from URL
  RewriteCond %{THE_REQUEST} /index\.html[\s?] [NC]
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# ---- Block access to sensitive files ----
<FilesMatch "(\.htaccess|\.htpasswd|\.git|README\.md)$">
  Order Allow,Deny
  Deny from all
</FilesMatch>
