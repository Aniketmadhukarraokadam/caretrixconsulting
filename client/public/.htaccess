# =============================================
# Caretrix Consulting — Production .htaccess
# Apache Configuration for Shared Hosting & SPA
# =============================================

# ---- GZIP / Deflate Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/ld+json
  AddOutputFilterByType DEFLATE font/woff2
  AddOutputFilterByType DEFLATE font/woff
</IfModule>

# ---- Browser Caching (Leverage Cache-Control) ----
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML - NEVER cache index.html so users always get newest JS bundle
  ExpiresByType text/html                       "access plus 0 seconds"

  # CSS & JS (hashed filenames - safe for 1 year immutable)
  ExpiresByType text/css                        "access plus 1 year"
  ExpiresByType application/javascript          "access plus 1 year"
  ExpiresByType text/javascript                 "access plus 1 year"

  # Images
  ExpiresByType image/png                       "access plus 1 year"
  ExpiresByType image/jpg                       "access plus 1 year"
  ExpiresByType image/jpeg                      "access plus 1 year"
  ExpiresByType image/gif                       "access plus 1 year"
  ExpiresByType image/webp                      "access plus 1 year"
  ExpiresByType image/svg+xml                   "access plus 1 year"
  ExpiresByType image/x-icon                    "access plus 1 year"

  # Fonts
  ExpiresByType font/woff2                      "access plus 1 year"
  ExpiresByType font/woff                       "access plus 1 year"
  ExpiresByType application/font-woff           "access plus 1 year"
  ExpiresByType application/font-woff2          "access plus 1 year"

  # XML / Sitemap / Text
  ExpiresByType application/xml                 "access plus 1 day"
  ExpiresByType text/xml                        "access plus 1 day"
  ExpiresByType text/plain                      "access plus 1 day"
</IfModule>

# ---- Cache-Control Headers ----
<IfModule mod_headers.c>
  # Hashed assets cached 1 year
  <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|woff|woff2|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML files MUST be revalidated immediately to avoid stale bundle crashes
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ---- Directory Listing Security ----
Options -Indexes

# ---- Default Document ----
DirectoryIndex index.html

# ---- Single Page Application (SPA) React Router Rewrites ----
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Canonical Redirect: www to non-www (apex domain)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 2. Force HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 3. Don't rewrite real files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Route all other URLs to index.html for React Router
  RewriteRule ^ index.html [L]
</IfModule>

# ---- Error Pages ----
ErrorDocument 404 /index.html
